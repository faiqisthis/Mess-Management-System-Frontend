import React, { useState } from 'react';
import { UserRole } from '../App';
import { Calendar, Check, X, Edit2, Save } from 'lucide-react';

interface AttendancePageProps {
  userRole: UserRole;
  userId: string;
}

interface AttendanceRecord {
  id: string;
  studentId: string;
  studentName: string;
  date: string;
  breakfast: boolean;
  lunch: boolean;
  snacks: boolean;
  dinner: boolean;
}

export function AttendancePage({ userRole, userId }: AttendancePageProps) {
  const today = new Date().toISOString().split('T')[0];
  
  const [attendanceRecords, setAttendanceRecords] = useState<AttendanceRecord[]>([
    {
      id: '1',
      studentId: '1',
      studentName: 'John Doe',
      date: today,
      breakfast: true,
      lunch: true,
      snacks: false,
      dinner: true,
    },
    {
      id: '2',
      studentId: '101',
      studentName: 'Alice Johnson',
      date: today,
      breakfast: true,
      lunch: false,
      snacks: true,
      dinner: false,
    },
    {
      id: '3',
      studentId: '102',
      studentName: 'Bob Williams',
      date: today,
      breakfast: false,
      lunch: true,
      snacks: true,
      dinner: true,
    },
    {
      id: '4',
      studentId: '103',
      studentName: 'Emma Davis',
      date: today,
      breakfast: true,
      lunch: true,
      snacks: true,
      dinner: true,
    },
  ]);

  const [editMode, setEditMode] = useState(false);

  const handleToggleAttendance = (recordId: string, meal: 'breakfast' | 'lunch' | 'snacks' | 'dinner') => {
    setAttendanceRecords(records =>
      records.map(record =>
        record.id === recordId ? { ...record, [meal]: !record[meal] } : record
      )
    );
  };

  const AttendanceIcon = ({ present }: { present: boolean }) => (
    <div
      className={`w-6 h-6 rounded-full flex items-center justify-center ${
        present ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'
      }`}
    >
      {present ? <Check className="w-4 h-4" /> : <X className="w-4 h-4" />}
    </div>
  );

  if (userRole === 'student') {
    const studentRecord = attendanceRecords.find(r => r.studentId === userId);
    
    return (
      <div className="max-w-4xl mx-auto">
        <div className="mb-8">
          <h1 className="text-3xl mb-2 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            My Attendance
          </h1>
          <p className="text-gray-600">View your meal attendance records</p>
        </div>

        <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div className="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4 flex items-center gap-3">
            <Calendar className="w-6 h-6 text-white" />
            <div>
              <h2 className="text-xl text-white">Today&apos;s Attendance</h2>
              <p className="text-sm text-blue-100">{new Date().toLocaleDateString()}</p>
            </div>
          </div>

          {studentRecord && (
            <div className="p-6">
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                  { key: 'breakfast', label: 'Breakfast' },
                  { key: 'lunch', label: 'Lunch' },
                  { key: 'snacks', label: 'Snacks' },
                  { key: 'dinner', label: 'Dinner' },
                ].map(({ key, label }) => (
                  <div
                    key={key}
                    className="p-4 border border-gray-200 rounded-lg text-center"
                  >
                    <p className="text-sm text-gray-600 mb-3">{label}</p>
                    <div className="flex justify-center">
                      <AttendanceIcon present={studentRecord[key as keyof typeof studentRecord] as boolean} />
                    </div>
                    <p className="text-sm mt-2">
                      {studentRecord[key as keyof typeof studentRecord] ? (
                        <span className="text-green-600">Present</span>
                      ) : (
                        <span className="text-red-600">Absent</span>
                      )}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    );
  }

  // Teacher/Admin view
  return (
    <div className="max-w-7xl mx-auto">
      <div className="mb-8 flex items-center justify-between">
        <div>
          <h1 className="text-3xl mb-2 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            Attendance Management
          </h1>
          <p className="text-gray-600">Mark and manage student meal attendance</p>
        </div>
        <button
          onClick={() => setEditMode(!editMode)}
          className={`flex items-center gap-2 px-4 py-2 rounded-lg transition-all ${
            editMode
              ? 'bg-green-600 text-white hover:bg-green-700'
              : 'bg-blue-600 text-white hover:bg-blue-700'
          }`}
        >
          {editMode ? (
            <>
              <Save className="w-4 h-4" />
              Save Changes
            </>
          ) : (
            <>
              <Edit2 className="w-4 h-4" />
              Edit Mode
            </>
          )}
        </button>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead className="bg-gray-50 border-b border-gray-200">
              <tr>
                <th className="px-6 py-4 text-left text-sm text-gray-700">Student Name</th>
                <th className="px-6 py-4 text-center text-sm text-gray-700">Breakfast</th>
                <th className="px-6 py-4 text-center text-sm text-gray-700">Lunch</th>
                <th className="px-6 py-4 text-center text-sm text-gray-700">Snacks</th>
                <th className="px-6 py-4 text-center text-sm text-gray-700">Dinner</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200">
              {attendanceRecords.map((record) => (
                <tr key={record.id} className="hover:bg-gray-50 transition-colors">
                  <td className="px-6 py-4">
                    <div className="flex items-center gap-3">
                      <div className="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white text-sm">
                        {record.studentName.charAt(0)}
                      </div>
                      <span>{record.studentName}</span>
                    </div>
                  </td>
                  {['breakfast', 'lunch', 'snacks', 'dinner'].map((meal) => (
                    <td key={meal} className="px-6 py-4 text-center">
                      {editMode ? (
                        <button
                          onClick={() => handleToggleAttendance(record.id, meal as any)}
                          className="mx-auto hover:scale-110 transition-transform"
                        >
                          <AttendanceIcon present={record[meal as keyof typeof record] as boolean} />
                        </button>
                      ) : (
                        <div className="flex justify-center">
                          <AttendanceIcon present={record[meal as keyof typeof record] as boolean} />
                        </div>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
